.DS_Store
__pycache__/
.venv/

# Data is rebuilt by fetch_data.py, so it stays out of git
data/raw/
data/clipped/

# Video and frames are never committed (privacy and size)
video/
frames/
*.MOV
*.mov
*.mp4
*.gpx

# Large or generated outputs
*.zip
*.qgz~

# Derived outputs are rebuilt by the analysis scripts.
# Exception: the filming route, so the team can open it without running the code
data/derived/*
!data/derived/route/
!data/derived/route/route.gpx
